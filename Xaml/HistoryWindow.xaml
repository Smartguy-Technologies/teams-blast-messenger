<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send History - Teams Blast Messenger" Height="720" Width="1180" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="BtnInteractions" Content="Check interactions" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                    <Button Name="BtnRetry" Content="Retry failed" IsEnabled="False" ToolTip="Send again to recipients that failed or were cancelled, with their original messages"/>
                    <Button Name="BtnReuse" Content="Reuse message" IsEnabled="False" ToolTip="Copy this blast's template into the editor"/>
                    <Button Name="BtnExport" Content="Export CSV" IsEnabled="False"/>
                    <Button Name="BtnDelete" Content="Delete" IsEnabled="False"/>
                    <Button Name="BtnOpenFolder" Content="Open folder"/>
                    <Button Name="BtnRefresh" Content="Refresh"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Send history" Style="{StaticResource CardTitle}" Margin="0"/>
                    <TextBlock Name="TxtSummary" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid Name="GridBlasts" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sent" Binding="{Binding CreatedLocal}" Width="150"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/>
                        <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="115"/>
                        <DataGridCheckBoxColumn Header="Test" Binding="{Binding IsTest, Mode=OneWay}" Width="45"/>
                        <DataGridTextColumn Header="Recipients" Binding="{Binding RecipientCount}" Width="80"/>
                        <DataGridTextColumn Header="Sent OK" Binding="{Binding SentCount}" Width="70"/>
                        <DataGridTextColumn Header="Failed" Binding="{Binding FailedCount}" Width="60"/>
                        <DataGridTextColumn Header="Replied" Binding="{Binding ResponseSummary}" Width="70"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding TemplatePreview}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DataGrid Name="GridRecipients" IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="210"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="Sent" Binding="{Binding SentLocal}" Width="140"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Message sent" Style="{StaticResource CardTitle}"/>
                        <TextBox Name="TxtMessage" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FAFBFD"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
