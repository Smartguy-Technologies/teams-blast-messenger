<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Microsoft Graph" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="6">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Sign in with your work account" Style="{StaticResource CardTitle}"/>
                <TextBlock Name="TxtInstructions" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                <TextBox Name="TxtUserCode" IsReadOnly="True" FontSize="28" FontFamily="Consolas" FontWeight="Bold" HorizontalContentAlignment="Center"
                         Margin="0,14" Padding="8" BorderBrush="#5B5FC7" Foreground="#464EB8"/>
                <TextBlock Name="TxtStatus" Text="Waiting for you to finish signing in…" Style="{StaticResource Muted}"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
            <Button Name="BtnCancel" Content="Cancel" IsCancel="True"/>
            <Button Name="BtnCopyOpen" Content="Copy code and open sign-in page" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
